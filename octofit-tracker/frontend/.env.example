# OctoFit Tracker Frontend Environment Configuration
#
# IMPORTANT: Copy this file to `.env.local` and update the values.
# Do NOT commit `.env.local` to git (it should be in .gitignore).
#
# For Codespaces environments:
# - Set VITE_CODESPACE_NAME to your Codespace name
# - You can find it in the URL: https://YOUR_CODESPACE_NAME-5173.app.github.dev
# - Example: VITE_CODESPACE_NAME=scaling-space-waddle-pxx7gwvrr4q27v96
#
# For local development:
# - Leave VITE_CODESPACE_NAME empty or comment it out
# - The app will use http://localhost:8000/api/...

VITE_CODESPACE_NAME=
